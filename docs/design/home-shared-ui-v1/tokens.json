    "cardGap": 16,
    "sectionGap": 32,
    "radiusControl": 6,
    "radiusCard": 8,
    "radiusDialog": 8,
    "minTarget": 44,
    "minPrimaryHeight": 48,
    "headerMinHeight": 56,
    "focusWidth": 3,
    "focusOffset": 3
  },
  "motion": {
    "durationMs": 160,
    "reducedDurationMs": 0,
    "properties": [
      "color",
      "background-color",
      "border-color",
      "opacity"
    ]
  },
  "effects": {
    "cardShadow": "none",
    "modalShadow": "none",
    "headerBackdropFilter": "none",
    "heroBackground": "var(--bg)"
  },
  "contrast": {
    "normalTextMinimum": 4.5,
    "largeTextMinimum": 3,
    "controlBoundaryMinimum": 3,
    "focusMinimum": 3
  },
  "integration": {
    "sharedRoot": [
      "bg",
      "surface",
      "surface2",
      "surface3",
      "text",
      "muted",
      "border",
      "focus"
    ],
    "newUiPairs": [
      "accentFill/onAccent",
      "accentHover/onAccent",
      "dangerFill/onDanger",
      "dangerHover/onDanger",
      "accentText/accentSoft",
      "alertText/alertBg"
    ],
    "cssPrefix": "--ui- for new paired control/status tokens; existing bg/surface/text variables retain their names",
    "preserveLegacy": [
      "--accent",
      "--accent-fill",
      "--on-accent",
      "--clock-active",
      "--danger",
      "--warn",
      "--ok",
      "board and piece tokens"
    ],
    "reason": "Shared components switch to --ui- pairs together. Keep legacy game-specific pairs intact until their own audit; do not globally replace white foregrounds, game colors or paused restaurant styles."
  }
}
